# Keep the build context small and make sure nothing local leaks into an image.
node_modules
dist
.git
.github
.claude

# Secrets. These must come from the platform's environment settings, never
# from a file baked into an image — an image layer is readable by anyone who
# can pull it.
.env
.env.*
!.env.example

# The frontend IS part of this image now — it is built inside and served from
# the same origin. Only its build artefacts and deps are excluded.
web/node_modules
web/dist

# Not needed at runtime.
docs
*.log
coverage
README.md
