# Production environment for the API.
#
# Set these in the hosting platform's variables UI. Do NOT commit a filled-in
# copy of this file — the whole point of the platform's secret store is that
# the values never sit in the repository or in an image layer.

NODE_ENV=production

# The platform usually injects PORT. server.ts reads it; leave it unset unless
# your host expects you to pick one.
# PORT=4000

# ---- Where the frontend lives ----
# This is also the allowed CORS origin. It must be the exact scheme + host,
# with no trailing slash — a mismatch here is the usual cause of a CORS error
# that looks inexplicable.
APP_URL=https://app.yourname.me

# Any additional browser origins, comma-separated. Preview deployments go here.
CORS_ORIGINS=

# ---- Database ----
# Your host's managed Postgres connection string. Railway and Render inject
# this automatically if you attach a database — check before setting it by hand.
# Append ?sslmode=require if the provider needs it and does not already.
DATABASE_URL=

# ---- Auth ----
# GENERATE FRESH ONES. Do not reuse the development secrets, and do not reuse
# the same value for both:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Changing either of these invalidates every existing session, which is the
# correct emergency response if you think one has leaked.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ---- AI (voice billing) ----
# Not used until the voice pipeline is built. Leave blank.
ANTHROPIC_API_KEY=
ASR_PROVIDER=sarvam
SARVAM_API_KEY=

# ---- Optional integrations ----
# E-way bill via a GSP. Needs a commercial account.
EWAYBILL_BASE_URL=
EWAYBILL_GSP_CLIENT_ID=
EWAYBILL_GSP_CLIENT_SECRET=
EWAYBILL_USERNAME=
EWAYBILL_PASSWORD=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
