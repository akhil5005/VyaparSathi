# ---- Core ----
NODE_ENV=development
PORT=4000

# Where the frontend is served from. Also the default allowed CORS origin.
# Dev: the Vite server. Production: https://app.yourname.me
APP_URL=http://localhost:5173

# Any *additional* browser origins allowed to call this API, comma-separated.
# APP_URL is always allowed, so this is only for extras — a preview deploy, or
# a local Vite pointed at the deployed API.
#   CORS_ORIGINS=https://staging.yourname.me,http://localhost:4173
CORS_ORIGINS=

# ---- Database ----
# No install needed:  npm run dev:db   (boots a persistent embedded Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/vyapar_sathi_dev?schema=public"
#
# Or your own Postgres:
#   docker run --name vyapar-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:17
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vyapar_sathi?schema=public"

# ---- Auth ----
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Account lockout
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ---- Outbound messages ----
# Password reset links are emailed when both are set; otherwise they are only
# logged, which in production means nobody receives them.
#
# Not SMS: reaching an Indian mobile needs DLT registration of the sender ID
# and every template under the TRAI mandate — days of paperwork and a
# registered business. The working alternative is the owner setting a staff
# password from Settings -> Staff.
RESEND_API_KEY=
MAIL_FROM="Vyapar Sathi <noreply@yourdomain.com>"

# ---- AI (voice billing) ----
ANTHROPIC_API_KEY=
# Punjabi ASR provider: "sarvam" (recommended for pa-IN) or "openai"
ASR_PROVIDER=sarvam
SARVAM_API_KEY=
OPENAI_API_KEY=

# ---- Optional integrations ----
# NIC e-way bill (GSP credentials — get these from your GSP, e.g. ClearTax/Masters India)
EWAYBILL_BASE_URL=
EWAYBILL_GSP_CLIENT_ID=
EWAYBILL_GSP_CLIENT_SECRET=
EWAYBILL_USERNAME=
EWAYBILL_PASSWORD=

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
